# Protocol Digital Twin Platform - Environment Configuration Example

# Application Settings
NTWIN_ENVIRONMENT=development
NTWIN_DEBUG=false
NTWIN_HOST=127.0.0.1
NTWIN_PORT=8000
NTWIN_API_PREFIX=/api/v1

# Security & CORS (comma-separated or list syntax)
NTWIN_CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
NTWIN_MAX_REQUEST_BODY_BYTES=10485760

# Database Settings (Optional in Phase 00, mandatory in Phase 02)
# NTWIN_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/protocol_twin
NTWIN_REQUIRE_DATABASE=false

# C++ Systems Engine IPC Settings (Optional in Phase 00, active in Phase 01)
# NTWIN_ENGINE_SOCKET_PATH=\\.\pipe\protocol_twin_engine
NTWIN_REQUIRE_ENGINE=false
