# Root .gitignore for Network Digital Twin & Security Verification Engine

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
env/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
apps/web/dist/
apps/web/coverage/
.turbo/

# C++ and CMake
build/
cmake-build-*/
out/
bin/
*.obj
*.o
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile.cmake
*.vcxproj*
*.sln
.vs/

# Database / Analytical fixtures & runtime data
data/*
!data/captures
data/captures/*
!data/captures/manifest.json
!data/captures/*.pcap
!data/captures/*.pcapng
*.pcap
*.pcapng
!tests/fixtures/*.pcap
!tests/fixtures/*.pcapng
!data/captures/*.pcap
!data/captures/*.pcapng
*.duckdb
*.parquet
migrations/versions/*.pyc

# IDEs
.idea/
.vscode/
*.swp
*.swo
